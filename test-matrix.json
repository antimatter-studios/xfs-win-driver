      "recipe": [
        {
          "op": "build-xfs-image"
        },
        {
          "op": "verify-ls",
          "path": "/",
          "expect_args": "'--expect-name' 'small.txt' '--expect-name' 'empty.txt' '--expect-name' 'pattern.bin' '--expect-name' 'dir' '--expect-name' 'manyentries' '--expect-name' 'link-to-small' '--expect-name' 'dangling-link'"
