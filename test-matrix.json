{
  "_format": "v2",
  "_doc": "xfs-win-driver matrix (#7). Every scenario runs on xfs-content.img, made by scripts/build-fixtures.sh: mkfs.xfs -L DJTEST, then populated by the kernel with the files its comments describe. Host-side scenarios read it with xfs.exe; win-mount-* mount it read-only through WinFsp. Sizes and hashes are of the content that script writes.",
  "scenarios": {
    "basic-info-volume": {
      "status": "pending",
      "image": "xfs-content.img",
      "_attempts": [],
      "_notes": "The superblock as the driver reads it: block size and the label mkfs.xfs was given.",
      "recipe": [
        {
          "op": "build-xfs-image"
        },
        {
          "op": "verify-info",
          "expect_args": "'--expect-stdout-contains' 'block size       4096'"
        },
        {
          "op": "verify-info",
          "expect_args": "'--expect-stdout-contains' 'volume name      \"DJTEST\"'"
        }
      ]
    },
